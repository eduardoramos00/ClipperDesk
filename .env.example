# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# Supabase — from your project's Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App database connection (Supabase Postgres).
# Get it from: Supabase Dashboard -> Connect -> "Session pooler" connection string.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Optional: transactional email (guest booking confirmations) via SMTP/nodemailer.
# Without SMTP_HOST, emails are printed to the server console instead.
# For Gmail use smtp.gmail.com with an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fade District <bookings@yourdomain.com>"
